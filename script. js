// State Management
let currentExamQuestions = [];
let userAnswers = {}; // { questionIndex: optionIndex }
let examTimer = null;
let secondsLeft = 300; // 5 minutes default

// DOM Elements
const configSection = document.getElementById('configSection');
const examSection = document.getElementById('examSection');
const resultsSection = document.getElementById('resultsSection');
const questionsContainer = document.getElementById('questionsContainer');
const reviewContainer = document.getElementById('reviewContainer');

const generateBtn = document.getElementById('generateBtn');
const submitExamBtn = document.getElementById('submitExamBtn');
const retakeBtn = document.getElementById('retakeBtn');

const topicInput = document.getElementById('topicInput');
const countInput = document.getElementById('countInput');
const difficultyInput = document.getElementById('difficultyInput');

const statusMessage = document.getElementById('statusMessage');
const statusText = document.getElementById('statusText');
const timerBadge = document.getElementById('timerBadge');
const timerText = document.getElementById('timerText');
const answeredCountEl = document.getElementById('answeredCount');
const totalQuestionsCountEl = document.getElementById('totalQuestionsCount');
const finalScoreEl = document.getElementById('finalScore');
const feedbackText = document.getElementById('feedbackText');

// 1. Fetch & Generate Questions via Backend
generateBtn.addEventListener('click', async () => {
  const topic = topicInput.value.trim() || 'General Knowledge';
  const count = parseInt(countInput.value, 10) || 5;
  const difficulty = difficultyInput.value;

  generateBtn.disabled = true;
  generateBtn.classList.add('opacity-50', 'cursor-not-allowed');
  statusMessage.classList.remove('hidden');
  statusText.textContent = `Gemini is generating ${count} ${difficulty} questions for "${topic}"...`;

  try {
    const prompt = `Generate exactly ${count} multiple-choice questions (MCQs) on the topic: "${topic}".
Difficulty level: ${difficulty}.

Requirements:
- Each question must have exactly 4 choices.
- One unambiguously correct answer index (0, 1, 2, or 3).
- A concise explanation of why the correct option is right.

Return strictly a JSON array matching this format without markdown code blocks:
[
  {
    "question": "Question text",
    "options": ["Option A", "Option B", "Option C", "Option D"],
    "correctAnswer": 0,
    "explanation": "Clear explanation of the correct answer."
  }
]`;

    const response = await fetch('/api/generate', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ prompt }),
    });

    if (!response.ok) {
      const errData = await response.json().catch(() => ({}));
      throw new Error(errData.error || `Server responded with status ${response.status}`);
    }

    const data = await response.json();
    let questions = [];

    // Parse the returned response
    if (Array.isArray(data)) {
      questions = data;
    } else if (data.questions && Array.isArray(data.questions)) {
      questions = data.questions;
    } else if (typeof data.text === 'string') {
      const cleanJson = data.text.replace(/```json/g, '').replace(/```/g, '').trim();
      questions = JSON.parse(cleanJson);
    }

    if (!questions || questions.length === 0) {
      throw new Error('No valid questions received from AI.');
    }

    // Start Exam
    startExam(questions);
  } catch (err) {
    console.error('Failed to generate exam:', err);
    alert(`Error: ${err.message || 'Could not connect to the question generator.'}`);
  } finally {
    generateBtn.disabled = false;
    generateBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    statusMessage.classList.add('hidden');
  }
});

// 2. Render and Start Exam
function startExam(questions) {
  currentExamQuestions = questions;
  userAnswers = {};
  secondsLeft = questions.length * 60; // 1 minute per question

  configSection.classList.add('hidden');
  resultsSection.classList.add('hidden');
  examSection.classList.remove('hidden');
  timerBadge.classList.remove('hidden');

  totalQuestionsCountEl.textContent = questions.length;
  updateAnsweredCounter();
  renderExamQuestions();
  startTimer();
}

function renderExamQuestions() {
  questionsContainer.innerHTML = '';
  const optionLabels = ['A', 'B', 'C', 'D'];

  currentExamQuestions.forEach((q, qIdx) => {
    const card = document.createElement('div');
    card.className = 'p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-3';

    card.innerHTML = `
      <div class="flex items-center justify-between">
        <span class="px-2.5 py-0.5 rounded-md bg-slate-800 text-slate-300 text-xs font-semibold">Question ${qIdx + 1} of ${currentExamQuestions.length}</span>
      </div>
      <p class="text-sm sm:text-base font-medium text-slate-100">${escapeHtml(q.question)}</p>
      <div class="space-y-2" id="optionsGroup-${qIdx}">
        ${q.options.map((opt, optIdx) => `
          <button 
            type="button" 
            onclick="selectOption(${qIdx}, ${optIdx})"
            id="opt-btn-${qIdx}-${optIdx}"
            class="w-full text-left p-3 rounded-xl border border-slate-800 bg-slate-950 hover:bg-slate-850 hover:border-slate-700 text-xs sm:text-sm text-slate-200 transition-colors flex items-center gap-3"
          >
            <span class="w-6 h-6 rounded-lg bg-slate-800 text-slate-300 flex items-center justify-center font-bold text-xs shrink-0">${optionLabels[optIdx]}</span>
            <span>${escapeHtml(opt)}</span>
          </button>
        `).join('')}
      </div>
    `;

    questionsContainer.appendChild(card);
  });
}

// 3. User selects an option
window.selectOption = function(qIndex, optionIndex) {
  userAnswers[qIndex] = optionIndex;

  // Update styles for the options in this question
  const totalOpts = currentExamQuestions[qIndex].options.length;
  for (let i = 0; i < totalOpts; i++) {
    const btn = document.getElementById(`opt-btn-${qIndex}-${i}`);
    if (i === optionIndex) {
      btn.className = 'w-full text-left p-3 rounded-xl border border-emerald-500 bg-emerald-950/30 text-emerald-300 transition-colors flex items-center gap-3 font-medium';
    } else {
      btn.className = 'w-full text-left p-3 rounded-xl border border-slate-800 bg-slate-950 hover:bg-slate-850 text-xs sm:text-sm text-slate-200 transition-colors flex items-center gap-3';
    }
  }

  updateAnsweredCounter();
};

function updateAnsweredCounter() {
  const answered = Object.keys(userAnswers).length;
  answeredCountEl.textContent = answered;
}

// 4. Timer Logic
function startTimer() {
  if (examTimer) clearInterval(examTimer);
  updateTimerDisplay();

  examTimer = setInterval(() => {
    secondsLeft--;
    updateTimerDisplay();
    if (secondsLeft <= 0) {
      clearInterval(examTimer);
      alert('Time is up! Your answers are being submitted.');
      submitExam();
    }
  }, 1000);
}

function updateTimerDisplay() {
  const mins = Math.floor(secondsLeft / 60);
  const secs = secondsLeft % 60;
  timerText.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
}

// 5. Submit & Score Calculation
submitExamBtn.addEventListener('click', () => {
  const answered = Object.keys(userAnswers).length;
  const total = currentExamQuestions.length;

  if (answered < total) {
    if (!confirm(`You have only answered ${answered} of ${total} questions. Do you still want to submit?`)) {
      return;
    }
  }
  submitExam();
});

function submitExam() {
  if (examTimer) clearInterval(examTimer);
  timerBadge.classList.add('hidden');
  examSection.classList.add('hidden');
  resultsSection.classList.remove('hidden');

  let score = 0;
  reviewContainer.innerHTML = '';

  currentExamQuestions.forEach((q, idx) => {
    const chosen = userAnswers[idx];
    const isCorrect = chosen === q.correctAnswer;
    if (isCorrect) score++;

    const reviewCard = document.createElement('div');
    reviewCard.className = `p-4 rounded-xl border ${isCorrect ? 'border-emerald-500/40 bg-emerald-950/20' : 'border-rose-500/40 bg-rose-950/20'} space-y-2 text-xs sm:text-sm`;

    reviewCard.innerHTML = `
      <div class="flex items-center justify-between">
        <span class="font-bold text-white">Q${idx + 1}: ${escapeHtml(q.question)}</span>
        <span class="px-2 py-0.5 rounded text-[11px] font-bold ${isCorrect ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400'}">
          ${isCorrect ? '✓ Correct (+1)' : '✗ Incorrect'}
        </span>
      </div>
      <div class="text-xs text-slate-300">
        <div>Your Answer: <strong class="${isCorrect ? 'text-emerald-400' : 'text-rose-400'}">${chosen !== undefined ? escapeHtml(q.options[chosen]) : 'None (Skipped)'}</strong></div>
        ${!isCorrect ? `<div class="text-emerald-400">Correct Answer: <strong>${escapeHtml(q.options[q.correctAnswer])}</strong></div>` : ''}
      </div>
      <div class="p-2.5 rounded-lg bg-slate-950/80 text-xs text-slate-400 border border-slate-800">
        <strong class="text-slate-300">Explanation:</strong> ${escapeHtml(q.explanation || 'Refer to fundamental concepts.')}
      </div>
    `;

    reviewContainer.appendChild(reviewCard);
  });

  const total = currentExamQuestions.length;
  finalScoreEl.textContent = `${score} / ${total}`;

  const percentage = Math.round((score / total) * 100);
  if (percentage >= 80) {
    feedbackText.textContent = `Outstanding work! You scored ${percentage}% and demonstrated solid mastery of the topic.`;
  } else if (percentage >= 50) {
    feedbackText.textContent = `Good effort! You scored ${percentage}%. Review the explanations below to brush up on missed concepts.`;
  } else {
    feedbackText.textContent = `You scored ${percentage}%. Don't worry—use the detailed review below to study the questions and try again!`;
  }
}

// 6. Retake / Reset
retakeBtn.addEventListener('click', () => {
  resultsSection.classList.add('hidden');
  configSection.classList.remove('hidden');
});

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}
